<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.paperhead.BetterNotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>PinPlan Notes</name>
  <name xml:lang="zh_CN">轻笺 · PinPlan</name>
  <summary>Pinned notes and checklists for Linux</summary>
  <summary xml:lang="zh_CN">桌面便签与计划清单</summary>
  <description>
    <p>
      PinPlan Notes is a simple local-first sticky notes and checklist app for GNOME.
      Create colorful notes, organize them with tags, and find them
      instantly with full-text search.
    </p>
    <p>Features:</p>
    <ul>
      <li>Pinned checklists with checkboxes, strikethrough, progress and manual ordering</li>
      <li>8 vibrant note colors</li>
      <li>Rich text editing (bold, italic, underline, strikethrough, bullet lists)</li>
      <li>Full-text search powered by SQLite FTS5</li>
      <li>Tags and categories with filtering</li>
      <li>Trash with restore and auto-purge</li>
      <li>Dark mode support</li>
      <li>Keyboard shortcuts</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.github.paperhead.BetterNotes.desktop</launchable>
  <url type="homepage">https://github.com/lbg2002/betternotes</url>
  <url type="bugtracker">https://github.com/lbg2002/betternotes/issues</url>
  <url type="vcs-browser">https://github.com/lbg2002/betternotes</url>
  <developer id="com.github.0xpaperhead">
    <name>0xpaperhead</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <caption>Main overview with colorful note cards</caption>
      <image>https://raw.githubusercontent.com/0xpaperhead/betternotes/main/data/screenshots/01-overview.png</image>
    </screenshot>
    <screenshot>
      <caption>Editing a sticky note with rich text formatting</caption>
      <image>https://raw.githubusercontent.com/0xpaperhead/betternotes/main/data/screenshots/02-editing.png</image>
    </screenshot>
    <screenshot>
      <caption>Dark mode support</caption>
      <image>https://raw.githubusercontent.com/0xpaperhead/betternotes/main/data/screenshots/03-dark-mode.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.4.2" date="2026-10-12">
      <description><p>Compact plan footer, icon-only fold, multi-monitor restore near dragged handle and first official PinPlan Debian package.</p></description>
    </release>
    <release version="0.4.1" date="2026-10-12">
      <description><p>Collapse notes into draggable floating circles or rounded rectangles; checklist progress, Enter-to-continue and undo deleted tasks.</p></description>
    </release>
    <release version="0.4.0" date="2026-10-12">
      <description><p>Global live font-family and font-size settings for notes, plan tasks and gallery previews.</p></description>
    </release>
    <release version="0.3.0" date="2026-10-12">
      <description><p>Compact drag-and-drop checklists, gray completion state, templates, due reminders and local backup.</p></description>
    </release>
    <release version="0.2.0" date="2026-10-12">
      <description>
        <p>Community fork: localized lightweight notes and pinned checklists.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-03-16">
      <description>
        <p>Bug fixes:</p>
        <ul>
          <li>Fix snap not launching due to broken python shebang from build-time SDK path</li>
          <li>Fix D-Bus registration by adding session bus slot to snap</li>
          <li>Rename app ID from com.github.souren to com.github.paperhead</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-02-21">
      <description>
        <p>Bug fixes and improvements.</p>
        <ul>
          <li>Add right-click context menu to delete tags</li>
          <li>Fix bullet list formatting</li>
          <li>Fix note selection and keyboard shortcuts</li>
          <li>Add screenshots to app listing</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-02-21">
      <description>
        <p>Initial release of BetterNotes.</p>
      </description>
    </release>
  </releases>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
</component>
